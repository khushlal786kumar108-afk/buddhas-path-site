# ============================================================
# Buddha's Path of Equality — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# The exact origin(s) your frontend is served from — comma separated.
# During local dev, this is wherever you open index.html from, e.g.
# a "Live Server" extension URL, or http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# ---- Database ----
# Real deployment (Postgres) — paste the connection string from
# Render/Neon/Supabase here (must start with postgresql://):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Local-only testing without any cloud database: change the
# provider in prisma/schema.prisma back to "sqlite" and use this
# instead: DATABASE_URL="file:./dev.db"

# ---- Auth / Sessions ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=bpe_session

# ---- Admin bootstrap (used only by `npm run seed:admin`) ----
ADMIN_EMAIL=admin@buddhaspathofequality.org
ADMIN_PASSWORD=ChangeThisImmediately!123
ADMIN_NAME="Khush Lal Kumar"

# ---- Password reset link ----
# The frontend page (index.html) that reads ?token= from the URL and
# shows the "set a new password" screen. Point this at wherever you
# actually serve site/index.html.
FRONTEND_RESET_URL=http://localhost:5500/index.html

# ---- Email (choose ONE provider and fill its block) ----
# Option A: any SMTP account (Gmail App Password, Zoho, Postmark SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Buddha's Path of Equality <no-reply@buddhaspathofequality.org>"

# ---- SMS (Twilio example — swap for MSG91/Fast2SMS if you prefer an
#      India-first provider, see README for the adapter to edit) ----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ---- OTP behaviour ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---- Dev convenience ----
# When true AND NODE_ENV=development, OTP codes are also printed to
# the server console/log so you can test registration without a real
# email/SMS provider configured yet. This flag is ignored entirely
# in production — it cannot be turned on outside development.
DEV_LOG_OTP_TO_CONSOLE=true
